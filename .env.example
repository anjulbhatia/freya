# Copy to .env and fill in. Postgres wins when DATABASE_URL is set;
# otherwise the kernel falls back to a local SQLite file (zero-config dev).
DATABASE_URL="postgresql://foundercycle:foundercycle@localhost:5432/foundercycle"
FOUNDERCYCLE_DB_PATH=""

# Agent model (auto = deterministic rules; set a model id for LLM classify later)
FC_MODEL="auto"
FC_APPROVAL_MODE="manual"
