{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "db": ["../../packages/db/src/index.ts"],
      "db/*": ["../../packages/db/src/*"],
      "shared": ["../../packages/shared/src/index.ts"],
      "shared/*": ["../../packages/shared/src/*"],
      "integrations": ["../../packages/integrations/src/index.ts"],
      "integrations/*": ["../../packages/integrations/src/*"],
      "auth": ["../../packages/auth/src/index.ts"],
      "auth/*": ["../../packages/auth/src/*"],
      "ui": ["../../packages/ui/src/index.ts"],
      "ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "components/ai-elements"]
}
