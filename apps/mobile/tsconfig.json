{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "shared": ["../../packages/shared/src/index.ts"],
      "shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["App.tsx", "index.js", "nativewind-env.d.ts"]
}
