{
  "name": "db",
  "version": "0.1.0",
  "private": true,
  "description": "Freya Postgres store: Drizzle schema, adapter, client facade. No shared/integration imports.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema-pg.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
