{
  "name": "foundercycle",
  "version": "0.1.0",
  "private": true,
  "description": "FounderCycle agent kernel: classifier, flows, integrations, store. UI-agnostic.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "exports": {
    "./agent/*": "./src/agent/*.ts",
    "./integrations/*": "./src/integrations/*.ts",
    "./db/*": "./src/db/*",
    "./types": "./src/types.ts",
    "./schemas": "./src/schemas.ts",
    "./index": "./src/index.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
