{
  "name": "foundercycle",
  "version": "0.1.0",
  "private": true,
  "description": "FounderCycle agent kernel: classifier, flows, integrations, store. UI-agnostic.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "drizzle-kit migrate",
